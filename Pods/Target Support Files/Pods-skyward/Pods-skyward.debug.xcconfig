ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaMQTT" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleBootstrap" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleHome" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleLogin" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleMessage" "${PODS_CONFIGURATION_BUILD_DIR}/Moya" "${PODS_CONFIGURATION_BUILD_DIR}/MqttCocoaAsyncSocket" "${PODS_CONFIGURATION_BUILD_DIR}/SWKit" "${PODS_CONFIGURATION_BUILD_DIR}/SWNetwork" "${PODS_CONFIGURATION_BUILD_DIR}/SWTheme" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_CONFIGURATION_BUILD_DIR}/TXCacheKit" "${PODS_CONFIGURATION_BUILD_DIR}/TXKit" "${PODS_CONFIGURATION_BUILD_DIR}/TXRouterKit"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaMQTT/CocoaMQTT.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleBootstrap/ModuleBootstrap.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleHome/ModuleHome.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleLogin/ModuleLogin.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ModuleMessage/ModuleMessage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Moya/Moya.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MqttCocoaAsyncSocket/MqttCocoaAsyncSocket.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SWKit/SWKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SWNetwork/SWNetwork.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SWTheme/SWTheme.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TXCacheKit/TXCacheKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TXKit/TXKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TXRouterKit/TXRouterKit.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"swiftCoreGraphics" -framework "Alamofire" -framework "CFNetwork" -framework "CocoaMQTT" -framework "Combine" -framework "Foundation" -framework "ModuleBootstrap" -framework "ModuleHome" -framework "ModuleLogin" -framework "ModuleMessage" -framework "Moya" -framework "MqttCocoaAsyncSocket" -framework "SWKit" -framework "SWNetwork" -framework "SWTheme" -framework "Security" -framework "SnapKit" -framework "TXCacheKit" -framework "TXKit" -framework "TXRouterKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "-F${PODS_CONFIGURATION_BUILD_DIR}/CocoaMQTT" "-F${PODS_CONFIGURATION_BUILD_DIR}/ModuleBootstrap" "-F${PODS_CONFIGURATION_BUILD_DIR}/ModuleHome" "-F${PODS_CONFIGURATION_BUILD_DIR}/ModuleLogin" "-F${PODS_CONFIGURATION_BUILD_DIR}/ModuleMessage" "-F${PODS_CONFIGURATION_BUILD_DIR}/Moya" "-F${PODS_CONFIGURATION_BUILD_DIR}/MqttCocoaAsyncSocket" "-F${PODS_CONFIGURATION_BUILD_DIR}/SWKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/SWNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/SWTheme" "-F${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TXCacheKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TXKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TXRouterKit"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
